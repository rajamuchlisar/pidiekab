# PidieKab Environment Configuration Example
# Copy to .env for local development: cp .env.example .env
# Never commit .env or secrets to version control.

# Application Environment (development, test, production)
PIDIEKAB_ENV=development

# Server Listen Address
PIDIEKAB_ADDR=127.0.0.1:8080

# Logging Level (debug, info, warn, error)
PIDIEKAB_LOG_LEVEL=info

# Server HTTP Timeouts (Go duration format: 5s, 15s, etc.)
PIDIEKAB_READ_HEADER_TIMEOUT=5s
PIDIEKAB_READ_TIMEOUT=15s
PIDIEKAB_WRITE_TIMEOUT=30s
PIDIEKAB_IDLE_TIMEOUT=60s
PIDIEKAB_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database Configuration
# Format: postgres://username:password@localhost:5432/database_name?sslmode=disable
PIDIEKAB_DATABASE_URL=postgres://postgres:admin@127.0.0.1:5432/pidiekab_dev?sslmode=disable
PIDIEKAB_DATABASE_MAX_CONNS=10
PIDIEKAB_DATABASE_MIN_CONNS=2
PIDIEKAB_DATABASE_MAX_CONN_LIFETIME=1h
PIDIEKAB_DATABASE_MAX_CONN_IDLE_TIME=30m
PIDIEKAB_DATABASE_HEALTH_CHECK_PERIOD=1m

# Static Asset & Frontend Directories
PIDIEKAB_PUBLIC_STATIC_DIR=frontend/public-site/dist
PIDIEKAB_CMS_STATIC_DIR=frontend/admin-cms/dist

# Media Storage Path (Local file persistence)
PIDIEKAB_STORAGE_PATH=data/media

# Static Site Generation (SSG) Pipeline & Worker Settings
PIDIEKAB_SSG_OUTPUT_ROOT=data/ssg
PIDIEKAB_SSG_RELEASES_TO_KEEP=5
PIDIEKAB_SSG_POLL_INTERVAL=5s
PIDIEKAB_SSG_JOB_MAX_ATTEMPTS=3

# Production Native TLS (HTTPS) Configuration
# When configured, pidiekab serves HTTPS directly on PIDIEKAB_ADDR (e.g. :443)
# and redirects all plaintext HTTP traffic on PIDIEKAB_HTTP_REDIRECT_ADDR (e.g. :80)
# PIDIEKAB_TLS_CERT_FILE=/etc/letsencrypt/live/pidiekab.go.id/fullchain.pem
# PIDIEKAB_TLS_KEY_FILE=/etc/letsencrypt/live/pidiekab.go.id/privkey.pem
# PIDIEKAB_HTTP_REDIRECT_ADDR=:80
