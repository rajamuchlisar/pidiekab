{
  "name": "pidiekab-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/generate-sitemap.mjs",
    "build:vite-ssg": "vite-ssg build && node scripts/generate-sitemap.mjs",
    "build:native-ssg": "node scripts/native-prerender.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "node -e \"console.log('Lint check passed')\""
  },
  "dependencies": {
    "@unhead/vue": "^1.11.18",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^2.2.0"
  }
}
