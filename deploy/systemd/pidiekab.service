[Unit]
Description=PidieKab Regional Promotion & Discovery Platform
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=pidiekab
Group=pidiekab
WorkingDirectory=/opt/pidiekab/current
EnvironmentFile=/etc/pidiekab/pidiekab.env
ExecStart=/opt/pidiekab/current/bin/pidiekab
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=90s
KillSignal=SIGTERM

# Security sandboxing & capability inheritance
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/pidiekab
ReadWritePaths=/var/lib/pidiekab /opt/pidiekab/releases

[Install]
WantedBy=multi-user.target
