[Unit]
Description=PidieKab Regional Promotion & Discovery Platform
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pidiekab
Group=pidiekab
WorkingDirectory=/opt/pidiekab
EnvironmentFile=/etc/pidiekab/pidiekab.env
ExecStart=/opt/pidiekab/bin/pidiekab
Restart=on-failure
RestartSec=5s

# Security sandboxing
LimitNOFILE=65535
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pidiekab/uploads /opt/pidiekab/releases

[Install]
WantedBy=multi-user.target
