# ==============================================================================
# PidieKab Production Environment Configuration Template
# Place at: /etc/pidiekab/pidiekab.env
# Permissions: 0600 (chown root:pidiekab /etc/pidiekab/pidiekab.env)
# ==============================================================================

# Application Environment
PIDIEKAB_ENV=production
PIDIEKAB_ADDR=127.0.0.1:8080
PIDIEKAB_LOG_LEVEL=info

# HTTP Server Timeouts
PIDIEKAB_READ_HEADER_TIMEOUT=5s
PIDIEKAB_READ_TIMEOUT=15s
PIDIEKAB_WRITE_TIMEOUT=30s
PIDIEKAB_IDLE_TIMEOUT=60s
PIDIEKAB_SHUTDOWN_TIMEOUT=15s

# PostgreSQL 17 Database Connection Pool
PIDIEKAB_DATABASE_URL=postgres://pidiekab_user:SECURE_STRONG_PASSWORD_HERE@127.0.0.1:5432/pidiekab_production?sslmode=disable
PIDIEKAB_DATABASE_MAX_CONNS=25
PIDIEKAB_DATABASE_MIN_CONNS=5
PIDIEKAB_DATABASE_MAX_CONN_LIFETIME=1h
PIDIEKAB_DATABASE_MAX_CONN_IDLE_TIME=30m
PIDIEKAB_DATABASE_HEALTH_CHECK_PERIOD=1m

# Application Directories & Release Paths
PIDIEKAB_PUBLIC_STATIC_DIR=/opt/pidiekab/current/public
PIDIEKAB_CMS_STATIC_DIR=/opt/pidiekab/current/cms
PIDIEKAB_STORAGE_PATH=/var/lib/pidiekab/media
PIDIEKAB_SSG_OUTPUT_ROOT=/var/lib/pidiekab/ssg
PIDIEKAB_SSG_RELEASES_TO_KEEP=5
PIDIEKAB_SSG_POLL_INTERVAL=5s
PIDIEKAB_SSG_JOB_MAX_ATTEMPTS=3

PIDIEKAB_BASE_URL=https://pidiekab.web.id

# Optional: Native TLS Configuration (Leave empty if terminated at network firewall / Cloudflare)
# PIDIEKAB_TLS_CERT_FILE=/etc/letsencrypt/live/pidiekab.web.id/fullchain.pem
# PIDIEKAB_TLS_KEY_FILE=/etc/letsencrypt/live/pidiekab.web.id/privkey.pem
# PIDIEKAB_HTTP_REDIRECT_ADDR=:80
